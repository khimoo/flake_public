+	/* The grab hotkey grabs the keyboard for one shortcut only: release the grab once
+	 * every key pressed after the hotkey has been released again. */
+	bool releaseGrab = false;
+	if (_sdl->grabKeyboard())
+	{
+		if (ev.type == SDL_EVENT_KEY_DOWN)
+			_grabPressed.insert(ev.scancode);
+		else if ((_grabPressed.erase(ev.scancode) > 0) && _grabPressed.empty())
+			releaseGrab = true;
+	}
+
 	auto scancode = freerdp_keyboard_remap_key(_remapTable, rdp_scancode);
 #if defined(WITH_DEBUG_KBD)
