{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$root/.agents/hooks/proofread-howtouse.py\" ] || exit 0; exec python3 \"$root/.agents/hooks/proofread-howtouse.py\"",
            "timeout": 600,
            "statusMessage": "Proofreading docs/howtouse"
          }
        ]
      }
    ]
  }
}
