+// Send the text of the logical line around the cursor as surrounding text, so
+// that input methods can see what precedes the insertion point (for example
+// the prompt of a TUI program). Returns true if new state was set and needs a commit.
+static bool
+update_surrounding_text(bool force) {
+    _GLFWwindow *w = _glfwFocusedWindow();
+    if (!text_input || !ime_focused || !w || !_glfw.callbacks.get_ime_text_around_cursor) return false;
+    GLFWIMETextAroundCursor t = {0};
+    if (!_glfw.callbacks.get_ime_text_around_cursor((GLFWwindow *)w, &t)) return false;
+    const char *before = t.before ? t.before : "", *after = t.after ? t.after : "";
+    // The protocol limits surrounding text to 4000 bytes. Keep the end of
+    // before and the start of after, cut at UTF-8 character boundaries.
+    size_t blen = strlen(before), alen = strlen(after);
+    if (blen > 2000) {
+        before += blen - 2000;
+        while ((*before & 0xC0) == 0x80) before++;
+        blen = strlen(before);
+    }
+    if (alen > 1000) {
+        alen = 1000;
+        while (alen > 0 && (after[alen] & 0xC0) == 0x80) alen--;
+    }
+    char *text = malloc(blen + alen + 1);
+    bool changed = false;
+    if (text) {
+        memcpy(text, before, blen);
+        memcpy(text + blen, after, alen);
+        text[blen + alen] = 0;
+        if (force || !last_surrounding || last_surrounding_cursor != blen || strcmp(last_surrounding, text) != 0) {
+            debug("text-input: updating surrounding text, cursor: %zu\n", blen);
+            zwp_text_input_v3_set_surrounding_text(text_input, text, (int32_t)blen, (int32_t)blen);
+            zwp_text_input_v3_set_text_change_cause(text_input, ZWP_TEXT_INPUT_V3_CHANGE_CAUSE_OTHER);
+            free(last_surrounding);
+            last_surrounding = text;
+            last_surrounding_cursor = blen;
+            changed = true;
+        } else free(text);
+    }
+    free(t.before);
+    free(t.after);
+    return changed;
+}
