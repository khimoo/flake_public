// 個人の設定を後に置き、generated.kdl の割り当てより優先する。
include "generated.kdl"

prefer-no-csd

layout {
    gaps 8
    focus-ring {
        width 2
    }
}

input {
    touchpad {
        tap
        natural-scroll
        dwt
    }

    mouse {
        accel-speed -0.8
        // accel-profile "flat"
    }
}

window-rule {
    match app-id=r#"^(org[.]fcitx[.]|fcitx5)"#
    open-floating true
}

output "eDP-1" {
        scale 1.2
}

binds {
    Mod+Ctrl+Left  { move-window-to-monitor-left; }
    Mod+Ctrl+Right { move-window-to-monitor-right; }
    Mod+Ctrl+Up    { move-window-to-monitor-up; }
    Mod+Ctrl+Down  { move-window-to-monitor-down; }
}
